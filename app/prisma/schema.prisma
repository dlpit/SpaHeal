// ============================================================================
// BU'S BEAUTY HIDEOUT - SPA MANAGEMENT SYSTEM
// Prisma Schema for MySQL Database
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. SYSTEM SETTINGS (Cài đặt hệ thống)
// ============================================================================

/// Danh mục nhóm dịch vụ (Gội Đầu Dưỡng Sinh, Waxing, v.v.)
model ServiceCategory {
  id        String    @id @default(cuid())
  name      String    @unique // "GỘI ĐẦU DƯỠNG SINH", "WAXING"
  slug      String    @unique // "goi-dau-duong-sinh", "waxing"
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  services Service[]

  @@map("service_categories")
}

/// Dịch vụ Spa (Mã DV, tên, giá niêm yết)
model Service {
  id         String   @id @default(cuid())
  code       String   @unique // Mã DV: "HS35", "BSF", "WF", ...
  name       String   // Tên: "Gội đầu dưỡng sinh Thư Giãn"
  price      Decimal  @db.Decimal(12, 0) // Giá niêm yết: 35000
  categoryId String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([categoryId])
  @@map("services")
}

/// Nhân viên
model Staff {
  id        String   @id @default(cuid())
  code      String   @unique // Mã NV: "BH", "MK"
  fullName  String   // "Bích Huyền", "My Kha"
  role      String   @default("Nhân viên") // "Nhân viên", "Quản lý"
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@map("staff")
}

/// Hình thức thanh toán
model PaymentMethod {
  id        String   @id @default(cuid())
  code      String   @unique // "TM", "QR", "CK"
  name      String   // "Tiền mặt", "QR Code", "Chuyển khoản"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  @@map("payment_methods")
}

/// Tài khoản ngân hàng nhận thanh toán
model PaymentAccount {
  id            String   @id @default(cuid())
  code          String   @unique // "MB", "VCB"
  bankName      String   // "MB BANK", "VIETCOMBANK"
  accountNumber String?
  accountName   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoices Invoice[]

  @@map("payment_accounts")
}

// ============================================================================
// 2. CRM (Khách hàng & Lịch hẹn)
// ============================================================================

/// Khách hàng
model Customer {
  id         String    @id @default(cuid())
  fullName   String
  phone      String    @unique
  email      String?
  address    String?
  gender     Gender?
  birthday   DateTime?
  totalSpent Decimal   @default(0) @db.Decimal(15, 0) // Tổng chi tiêu tích lũy
  visitCount Int       @default(0)
  lastVisit  DateTime?
  notes      String?   @db.Text
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  invoices     Invoice[]
  appointments Appointment[]

  @@index([fullName])
  @@map("customers")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Trạng thái lịch hẹn (Booking)
enum AppointmentStatus {
  CONFIRMED     // BK1: Đã xác nhận
  ARRIVED       // BK2: Đã đến
  IN_PROGRESS   // BK3: Đang phục vụ
  COMPLETED     // BK4: Hoàn thành
  CANCELLED     // BK5: Huỷ lịch
  RESCHEDULED   // BK6: Dời lịch
  NO_SHOW       // BK7: Không đến
  DEPOSIT       // BK8: Đặt cọc
}

/// Lịch hẹn
model Appointment {
  id         String            @id @default(cuid())
  customerId String
  date       DateTime          @db.Date
  startTime  String            // "09:00", "14:30" - giờ bắt đầu
  endTime    String?           // "10:00" - giờ kết thúc (ước tính)
  status     AppointmentStatus @default(CONFIRMED)
  notes      String?           @db.Text
  deposit    Decimal?          @db.Decimal(12, 0) // Tiền cọc (nếu có)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([date])
  @@index([status])
  @@map("appointments")
}

// ============================================================================
// 3. REVENUE (Doanh thu / Hóa đơn)
// ============================================================================

/// Trạng thái hóa đơn
enum InvoiceStatus {
  DRAFT      // Nháp
  COMPLETED  // Hoàn thành
  CANCELLED  // Đã hủy
  REFUNDED   // Đã hoàn tiền
}

/// Hóa đơn
model Invoice {
  id               String        @id @default(cuid())
  invoiceCode      String        @unique // Mã HĐ: "HD001", "HD002", ...
  date             DateTime      @db.Date
  customerId       String
  staffId          String?       // Nhân viên thực hiện
  paymentMethodId  String?       // Hình thức thanh toán
  paymentAccountId String?       // Tài khoản nhận
  subTotal         Decimal       @default(0) @db.Decimal(12, 0) // Tổng giá niêm yết
  discount         Decimal       @default(0) @db.Decimal(12, 0) // Giảm giá
  surcharge        Decimal       @default(0) @db.Decimal(12, 0) // Phụ thu
  totalAmount      Decimal       @default(0) @db.Decimal(12, 0) // Thành tiền = subTotal - discount + surcharge
  status           InvoiceStatus @default(COMPLETED)
  notes            String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  staff          Staff?          @relation(fields: [staffId], references: [id])
  paymentMethod  PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  items          InvoiceItem[]

  @@index([customerId])
  @@index([staffId])
  @@index([date])
  @@index([status])
  @@map("invoices")
}

/// Chi tiết hóa đơn (từng dịch vụ trong hóa đơn)
model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  serviceId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(12, 0) // Giá tại thời điểm bán (snapshot)
  amount    Decimal @db.Decimal(12, 0) // = quantity * unitPrice
  notes     String? @db.Text
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@index([serviceId])
  @@map("invoice_items")
}

// ============================================================================
// 4. EXPENSES (Chi phí)
// ============================================================================

/// Tính chất chi phí
enum ExpenseNature {
  FIXED         // Cố định (Thuê MB, Điện, Nước, Internet, Phần mềm)
  SEMI_FIXED    // Bán cố định (Điện, Nước - có phần biến đổi)
  VARIABLE      // Linh hoạt / Biến đổi, Tiêu hao
  ONE_TIME      // Một lần (Thiết bị)
}

/// Danh mục chi phí (theo cài đặt hệ thống)
model ExpenseCategory {
  id          String        @id @default(cuid())
  code        String        @unique // "CP001", "CP002", ...
  nature      ExpenseNature // Cố định, Bán cố định, Linh hoạt, Một lần
  group       String        // Nhóm: "Thuê mặt bằng", "Điện", "Dụng cụ bổ trợ", "Vật tư", "Thiết bị"
  itemName    String        // Loại cụ thể: "Wifi", "Capcut", "Cây massage da đầu", v.v.
  serviceGroup String?      // Thuộc nhóm DV nào: "Gội Đầu Dưỡng Sinh", "Waxing", "Chung"
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

/// Bản ghi chi phí hàng ngày
model Expense {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  expenseCategoryId String
  amount            Decimal  @db.Decimal(12, 0)
  quantity          Int      @default(1)
  description       String?  @db.Text
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expenseCategory ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])

  @@index([date])
  @@index([expenseCategoryId])
  @@map("expenses")
}

// ============================================================================
// 5. INVENTORY (Kho vật tư)
// ============================================================================

/// Nhà cung cấp
model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?  @db.Text
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventoryItems InventoryItem[]

  @@map("suppliers")
}

/// Vật tư trong kho
model InventoryItem {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  unit        String   @default("Cái") // Đơn vị: "Cái", "Chai", "Hộp", "Gói", ...
  quantity    Int      @default(0)      // Số lượng tồn kho
  minQuantity Int      @default(0)      // Mức tồn kho tối thiểu (cảnh báo)
  costPrice   Decimal  @default(0) @db.Decimal(12, 0) // Giá nhập
  supplierId  String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  stockTransactions StockTransaction[]

  @@index([supplierId])
  @@map("inventory_items")
}

/// Loại giao dịch kho
enum StockTransactionType {
  IMPORT // Nhập kho
  EXPORT // Xuất kho (sử dụng)
  ADJUST // Điều chỉnh
}

/// Lịch sử nhập/xuất kho
model StockTransaction {
  id              String               @id @default(cuid())
  inventoryItemId String
  type            StockTransactionType
  quantity        Int                  // Số lượng nhập/xuất
  unitCost        Decimal?             @db.Decimal(12, 0) // Đơn giá (khi nhập)
  totalCost       Decimal?             @db.Decimal(12, 0) // Tổng giá
  date            DateTime             @db.Date
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([inventoryItemId])
  @@index([date])
  @@map("stock_transactions")
}
